# ============================================================
# 命语（mingyu）部署配置
# 推荐直接运行一键脚本自动生成本文件：bash setup.sh
# 手动方式：cp .env.example .env 后按需修改
# 注意：.env 不要提交到任何代码仓库（含 API Key）
# ============================================================

# ---- 端口：绿联 NAS 上对外访问的端口（浏览器用 http://NAS_IP:端口 访问）----
UGREEN_PORT=9801

# ---- AI 解读（可选）----
# 不配 AI 也能正常使用：排盘、起卦、查询全部可用，只是没有 AI 解读。
# 想用 AI 解读时，填 DeepSeek 的 Key 并把 AI_BUILTIN_ENABLED 置为 true：
#   去 https://platform.deepseek.com 申请 API Key
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_PROVIDER_NAME=DeepSeek
AI_BUILTIN_ENABLED=false
AI_DEFAULT_ENABLED=false

# ---- 其他 ----
# 置为 true 时首页显示“功德箱”按钮（给作者打赏），默认关闭
VITE_ENABLE_DONATION_BOX=false
